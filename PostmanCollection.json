{
  "info": {
    "name": "Rocket Food Delivery REST API",
    "description": "Full verification collection for the Module 12 Rocket Food Delivery API. Covers every endpoint (list, get-by-id, create, update, delete, and the custom order/account endpoints). Run 'Auth - Login' first to populate {{token}}. Each resource folder's 'Create' request captures the new id into a collection variable so the Update/Delete requests in that folder can target it directly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "addressId", "value": "1" },
    { "key": "restaurantId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "customerId", "value": "1" },
    { "key": "courierId", "value": "1" },
    { "key": "courierStatusId", "value": "1" },
    { "key": "employeeId", "value": "1" },
    { "key": "orderStatusId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "productOrderId", "value": "2" },
    { "key": "userId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Requests whose name ends in a status code, e.g. \"... (404)\", assert that exact code.",
          "// Everything else is a happy-path request, so assert a 2xx.",
          "const match = pm.info.requestName.match(/\\((\\d{3})\\)\\s*$/);",
          "",
          "if (match) {",
          "    const expected = parseInt(match[1], 10);",
          "    pm.test(`Status code is ${expected}`, function () {",
          "        pm.response.to.have.status(expected);",
          "    });",
          "} else {",
          "    pm.test('Status code is 2xx', function () {",
          "        pm.expect(pm.response.code).to.be.within(200, 299);",
          "    });",
          "}",
          "",
          "pm.test('Response body is valid JSON', function () {",
          "    pm.response.to.have.jsonBody();",
          "});",
          "",
          "pm.test('Response time is under 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.accessToken) {",
                  "        pm.collectionVariables.set('token', json.accessToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"both@gmail.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth"
          }
        },
        {
          "name": "Login - Invalid Credentials (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"both@gmail.com\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth"
          }
        }
      ]
